// Build settings shared by Debug and Release. project.yml attaches this file to the HouseScan target.
//
// A bundle identifier can be registered by only one Apple Developer team, so each person
// signing on a device sets their own BUNDLE_ID_PREFIX and DEVELOPMENT_TEAM in Local.xcconfig
// (gitignored; copy Local.xcconfig.example). Keeping them here instead of in the project file
// stops signing changes from showing up as project.pbxproj diffs.

BUNDLE_ID_PREFIX = dev.housescanning

// The placement server the app uploads to when no -serverURL launch argument is given; Info.plist
// carries it as HouseScanServerURL. xcconfig reads // as a comment, so $() splits the slashes.
// Set it empty in Local.xcconfig to fall back to the bundled sample result.
HOUSESCAN_SERVER_URL = https:/$()/house-scanning-server.vercel.app

// The integration build (Config/Integration.xcconfig) sets these. Here they are the client
// build's: no bundle id suffix, the usual name, no capture API, and not the integration build, so
// nothing is recorded for the capture API and no photo leaves the phone, whatever the launch
// arguments say.
BUNDLE_ID_SUFFIX =
HOUSESCAN_DISPLAY_NAME = House Scan
HOUSESCAN_CAPTURE_API_URL =
HOUSESCAN_INTEGRATION_BUILD = NO
HOUSESCAN_CAPTURE_SEND_DEVICE_DATA = NO

#include? "Local.xcconfig"

// The commit the app was built from, for the scan stamp (HouseScanGitCommit in Info.plist). A
// build setting, not a build script: the TestFlight job refuses scripts in the build while the
// signing key exists. CI and `make ios` pass the real commit (HOUSESCAN_GIT_COMMIT=<sha>); a build
// that doesn't, such as one from Xcode's Run button, says "unknown".
HOUSESCAN_GIT_COMMIT = unknown
